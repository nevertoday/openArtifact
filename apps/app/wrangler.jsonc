{
  "name": "open-artifact-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-artifact",
      // Replaced by the real id when the team deploys to its own Cloudflare account.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/storage-cloudflare/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "open-artifact-files" }],
  // Daily purge of artifacts removed more than 30 days ago.
  "triggers": { "crons": ["30 3 * * *"] },
  // Public-link password attempts per visitor address and artifact, sign-in codes, and abuse reports per sender address.
  "ratelimits": [
    { "name": "UNLOCK_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGN_IN_EMAIL_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "SIGN_IN_ADDRESS_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "REPORT_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
  ],
  // Cloudflare Email Service, used when MAILER=cloudflare; MAIL_FROM must be on a domain verified there.
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI translates titles such as Chinese ones into the words of their links. scripts/production-config.mjs
  // binds it as "AI" in production only: bound here, local development would call Cloudflare for every publish.
  // Secrets (BETTER_AUTH_SECRET, USERCONTENT_SIGNING_KEY, optional OAuth client ids) live in .dev.vars locally
  // and in `wrangler secret put` when deployed.
  "vars": { "USERCONTENT_ORIGIN": "http://localhost:8789", "MCP_ORIGIN": "http://localhost:8788" }
}
