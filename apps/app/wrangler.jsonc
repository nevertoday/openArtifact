{
  "name": "open-artifact-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-artifact",
      // Replaced by the real id when the team deploys to its own Cloudflare account.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/storage-cloudflare/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "open-artifact-files" }],
  // Public-link password attempts per visitor address and artifact.
  "ratelimits": [{ "name": "UNLOCK_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Secrets (BETTER_AUTH_SECRET, USERCONTENT_SIGNING_KEY, optional OAuth client ids) live in .dev.vars locally
  // and in `wrangler secret put` when deployed.
  "vars": { "USERCONTENT_ORIGIN": "http://localhost:8789", "MCP_ORIGIN": "http://localhost:8788" }
}
